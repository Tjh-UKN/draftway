{
  "name": "northstar-workbench",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "test": "vitest run",
    "test:ui": "node scripts/check-ui.cjs",
    "test:workflow": "node scripts/check-workflow.cjs",
    "test:native": "node scripts/native-test.mjs",
    "test:markdown": "node scripts/check-markdown.cjs",
    "test:habits": "node scripts/check-habits.cjs",
    "test:health": "node scripts/check-health.cjs",
    "predev": "node scripts/prepare-excalidraw.mjs",
    "prebuild": "node scripts/prepare-excalidraw.mjs",
    "test:drawings": "node scripts/check-drawings.cjs",
    "test:workspaces": "node scripts/check-workspaces.cjs",
    "desktop:next": "node scripts/desktop.mjs dev --no-watch --config scripts/next-config.json",
    "desktop:next:build": "node scripts/desktop.mjs build --debug --no-bundle --config scripts/next-config.json",
    "test:native-browser": "node scripts/native-browser-test.mjs",
    "test:agent-live": "node scripts/agent-test.mjs",
    "test:native-business": "node scripts/native-business-test.mjs",
    "test:native-recovery": "node scripts/native-recovery-test.mjs",
    "test:agent-backup": "node scripts/agent-test.mjs pi backup"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "diff": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20",
      "sass": "^1.105.1",
      "@radix-ui/react-tabs": "^1.1.13"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "lodash-es": "^4.18.1",
    "katex": "^0.16.33"
  }
}
