{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draftway",
  "version": "0.6.2",
  "identifier": "com.northstar.workbench",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Draftway · 个人工作台", "width": 1440, "height": 960, "minWidth": 960, "minHeight": 640, "decorations": false, "backgroundColor": "#101b16" }],
    "security": { "csp": "default-src 'self'; frame-src 'self' http://knowledge.localhost https://knowledge.localhost knowledge:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; connect-src ipc: http://ipc.localhost 'self'; font-src 'self' https://esm.sh; object-src 'none'; base-uri 'self'; form-action 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Draftway 个人工作台",
    "category": "Productivity",
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese"], "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
